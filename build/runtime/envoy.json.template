{
  "admin": {
    "address": {
      "pipe": {
        "path": "/run/envoy/admin.sock",
        "mode": 384
      }
    }
  },
  "static_resources": {
    "listeners": [
      {
        "name": "access",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8080
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "access",
                  "normalize_path": true,
                  "stream_idle_timeout": "3600s",
                  "common_http_protocol_options": {
                    "max_stream_duration": "7200s"
                  },
                  "upgrade_configs": [
                    {
                      "upgrade_type": "websocket"
                    }
                  ],
                  "route_config": {
                    "name": "workspace",
                    "virtual_hosts": [
                      {
                        "name": "workspace",
                        "domains": [
                          "*"
                        ],
                        "routes": [
                          {
                            "match": {
                              "prefix": "/"
                            },
                            "route": {
                              "cluster": "code_server",
                              "timeout": "0s"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "local_reply_config": {
                    "mappers": [
                      {
                        "filter": {
                          "or_filter": {
                            "filters": [
                              {
                                "status_code_filter": {
                                  "comparison": {
                                    "op": "EQ",
                                    "value": {
                                      "default_value": 401,
                                      "runtime_key": "unused"
                                    }
                                  }
                                }
                              },
                              {
                                "status_code_filter": {
                                  "comparison": {
                                    "op": "EQ",
                                    "value": {
                                      "default_value": 403,
                                      "runtime_key": "unused"
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "status_code": 403,
                        "body": {
                          "filename": "/etc/envoy/pages/access-denied.html"
                        },
                        "body_format_override": {
                          "text_format_source": {
                            "inline_string": "%LOCAL_REPLY_BODY%"
                          },
                          "content_type": "text/html; charset=utf-8"
                        },
                        "headers_to_add": [
                          {
                            "header": {
                              "key": "cache-control",
                              "value": "no-store"
                            },
                            "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                          },
                          {
                            "header": {
                              "key": "x-content-type-options",
                              "value": "nosniff"
                            },
                            "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                          }
                        ]
                      },
                      {
                        "filter": {
                          "status_code_filter": {
                            "comparison": {
                              "op": "EQ",
                              "value": {
                                "default_value": 503,
                                "runtime_key": "unused"
                              }
                            }
                          }
                        },
                        "status_code": 503,
                        "body": {
                          "filename": "/etc/envoy/pages/unavailable.html"
                        },
                        "body_format_override": {
                          "text_format_source": {
                            "inline_string": "%LOCAL_REPLY_BODY%"
                          },
                          "content_type": "text/html; charset=utf-8"
                        },
                        "headers_to_add": [
                          {
                            "header": {
                              "key": "cache-control",
                              "value": "no-store"
                            },
                            "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                          },
                          {
                            "header": {
                              "key": "x-content-type-options",
                              "value": "nosniff"
                            },
                            "append_action": "OVERWRITE_IF_EXISTS_OR_ADD"
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.lua",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua",
                        "default_source_code": {
                          "filename": "/etc/envoy/lua/assertion.lua"
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.rbac",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC",
                        "rules": {
                          "action": "ALLOW",
                          "policies": {
                            "single_assertion": {
                              "permissions": [
                                {
                                  "any": true
                                }
                              ],
                              "principals": [
                                {
                                  "header": {
                                    "name": "cf-access-jwt-assertion",
                                    "string_match": {
                                      "safe_regex": {
                                        "regex": "[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+"
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.jwt_authn",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication",
                        "providers": {
                          "cloudflare": {
                            "issuer": "https://${CF_ACCESS_TEAM_DOMAIN:-}",
                            "audiences": [
                              "${CF_ACCESS_AUD:-}"
                            ],
                            "require_expiration": true,
                            "clock_skew_seconds": 1,
                            "from_headers": [
                              {
                                "name": "cf-access-jwt-assertion"
                              }
                            ],
                            "payload_in_metadata": "claims",
                            "header_in_metadata": "header",
                            "remote_jwks": {
                              "http_uri": {
                                "uri": "https://${CF_ACCESS_TEAM_DOMAIN:-}/cdn-cgi/access/certs",
                                "cluster": "cloudflare_jwks",
                                "timeout": "10s"
                              },
                              "cache_duration": "3600s",
                              "retry_policy": {
                                "num_retries": 2
                              }
                            }
                          }
                        },
                        "rules": [
                          {
                            "match": {
                              "prefix": "/"
                            },
                            "requires": {
                              "provider_name": "cloudflare"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "name": "envoy.filters.http.rbac",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC",
                        "rules": {
                          "action": "ALLOW",
                          "policies": {
                            "rs256": {
                              "permissions": [
                                {
                                  "any": true
                                }
                              ],
                              "principals": [
                                {
                                  "sourced_metadata": {
                                    "metadata_source": "DYNAMIC",
                                    "metadata_matcher": {
                                      "filter": "envoy.filters.http.jwt_authn",
                                      "path": [
                                        {
                                          "key": "header"
                                        },
                                        {
                                          "key": "alg"
                                        }
                                      ],
                                      "value": {
                                        "string_match": {
                                          "exact": "RS256"
                                        }
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.lua",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua",
                        "default_source_code": {
                          "filename": "/etc/envoy/lua/identity.lua"
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ],
                  "access_log": [
                    {
                      "name": "envoy.access_loggers.stdout",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog",
                        "log_format": {
                          "json_format": {
                            "timestamp": "%START_TIME%",
                            "method": "%REQ(:METHOD)%",
                            "path": "%PATH(NQ:PATH)%",
                            "host": "%REQ(:AUTHORITY)%",
                            "protocol": "%PROTOCOL%",
                            "status": "%RESPONSE_CODE%",
                            "response_details": "%RESPONSE_CODE_DETAILS%",
                            "denial_reason": "%DYNAMIC_METADATA(workspace.access:denial_reason)%",
                            "response_flags": "%RESPONSE_FLAGS%",
                            "peer": "%DOWNSTREAM_DIRECT_REMOTE_ADDRESS%",
                            "duration_ms": "%DURATION%",
                            "user_agent": "%REQ(USER-AGENT)%",
                            "request_id": "%REQ(X-REQUEST-ID)%"
                          }
                        }
                      },
                      "filter": {
                        "or_filter": {
                          "filters": [
                            {
                              "metadata_filter": {
                                "matcher": {
                                  "filter": "workspace.access",
                                  "path": [
                                    {
                                      "key": "quiet_healthcheck"
                                    }
                                  ],
                                  "value": {
                                    "bool_match": false
                                  }
                                },
                                "match_if_key_not_found": true
                              }
                            },
                            {
                              "status_code_filter": {
                                "comparison": {
                                  "op": "NE",
                                  "value": {
                                    "default_value": 403
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "clusters": [
      {
        "name": "code_server",
        "connect_timeout": "2s",
        "type": "STATIC",
        "load_assignment": {
          "cluster_name": "code_server",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "pipe": {
                        "path": "/run/code-server/backend.sock"
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "name": "cloudflare_jwks",
        "connect_timeout": "5s",
        "type": "STRICT_DNS",
        "dns_lookup_family": "V4_PREFERRED",
        "load_assignment": {
          "cluster_name": "cloudflare_jwks",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "${CF_ACCESS_TEAM_DOMAIN:-}",
                        "port_value": 443
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "transport_socket": {
          "name": "envoy.transport_sockets.tls",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
            "sni": "${CF_ACCESS_TEAM_DOMAIN:-}",
            "common_tls_context": {
              "validation_context": {
                "trusted_ca": {
                  "filename": "/etc/ssl/certs/ca-certificates.crt"
                },
                "match_typed_subject_alt_names": [
                  {
                    "san_type": "DNS",
                    "matcher": {
                      "exact": "${CF_ACCESS_TEAM_DOMAIN:-}"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    ]
  }
}
