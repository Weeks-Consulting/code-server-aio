# Published project image; override for your own fork.
CODE_SERVER_IMAGE=ghcr.io/weeks-consulting/code-server-aio:latest
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
# Required for origin JWT validation. Use your team hostname (no https://)
# and the Application Audience (AUD) from the code-server Access application.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-64-character-application-audience
# Opt in only for migration: recursive repair changes nested containers' data owners.
REPAIR_HOME_OWNERSHIP=false
# Maximum first-start Homebrew installation duration, in seconds.
HOMEBREW_INSTALL_TIMEOUT=600

# Optional: used by compose.backup.yaml (S3) or compose.backup-local.yaml (local).
# Backups run daily at 03:00 in the selected timezone.
# Generated by the installer or manage when backups are enabled. Save separately.
GPG_PASSPHRASE=
BACKUP_TIMEZONE=America/Chicago
BACKUP_CRON_EXPRESSION="0 3 * * *"
# Local backup folder; relative paths resolve beside the Compose files.
BACKUP_LOCAL_PATH=./backups
# Defaults to the Compose project name. Set a unique value across hosts sharing S3.
BACKUP_ID=
# Only needed for S3 backups with compose.backup.yaml.
AWS_S3_BUCKET_NAME=replace-with-your-backup-bucket
# Empty uses <BACKUP_ID or project name>/home.
AWS_S3_PATH=
AWS_ENDPOINT=s3.amazonaws.com
# Bucket addressing: auto selects by endpoint; path forces endpoint/bucket;
# dns forces bucket.endpoint. For R2, auto normally works; path forces path-style.
# This is separate from AWS_S3_PATH, which sets the object prefix in the bucket.
AWS_S3_BUCKET_LOOKUP=auto
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
